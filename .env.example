# ---------------------------------------------------------------------------
# Passive WordPress / headless store — example environment
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# MySQL (used by the official wordpress:php8.2-* image, which consumes these
# to generate wp-config.php; the API endpoints read the same values back).
MYSQL_DATABASE=appstore
MYSQL_USER=appstore
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-root

# Table prefix for BOTH core wp_* tables and our app_* tables.
TABLE_PREFIX=wp_

# --- Custom plugin secrets ---------------------------------------------------

# HS256 signing key for access tokens (required). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Browser origin allowed to call the API with credentials (Vite dev server).
# Multiple origins: comma separated, no spaces.
CORS_ORIGIN=http://localhost:5173

# Used ONLY when wp-config.php is unreachable (e.g. unit tests / CLI tooling).
# Format: mysql:host=127.0.0.1;port=3306;dbname=appstore;charset=utf8mb4
PDO_DSN_FALLBACK=

# Optional static credentials for the fallback DSN (tests only).
PDO_USER=
PDO_PASSWORD=

# Absolute or repo-relative path streamed for non-API routes in production.
SPA_INDEX_PATH=../frontend/dist/index.html

# Frontend dev server (compose wiring).
VITE_API_BASE=/api
VITE_PORT=5173
# HMAC key for /api/webhooks. X-Signature = hex hmac-sha256 of
# "<X-Timestamp>.<raw body>" where X-Timestamp is unix seconds (±300s window).
WEBHOOK_SECRET=

# 1 = demo/reviewer accounts are created with the shared demo password
# (customer-pass-123) for local development only. Anything else (default 0)
# gives them a random unusable password. Never set to 1 in production.
DEMO_ACCOUNTS=0
